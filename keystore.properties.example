# Beta-release signing keys. NEVER commit this file (it is gitignored).
# 1. Copy this file to keystore.properties (same folder as this example).
# 2. Generate a key once: keytool -genkeypair -v -keystore helios-beta.jks -alias helios-beta -keyalg RSA -keysize 2048 -validity 10000
# 3. Fill in the values below. storeFile may be absolute or relative to the project root.
storeFile=helios-beta.jks
storePassword=CHANGE_ME
keyAlias=helios-beta
keyPassword=CHANGE_ME
