{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Gradle: unit-test engine",
      "type": "shell",
      "command": ".\\gradlew.bat :core-image-engine:testDebugUnitTest",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Gradle: assembleDebug",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "ADB: install + launch on USB device",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug; if ($?) { adb shell am start -n com.helios.frame/.MainActivity }",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "ADB: devices + logcat (Helios)",
      "type": "shell",
      "command": "adb devices; if ($?) { adb logcat -c; if ($?) { adb logcat | Select-String -Pattern 'Helios|BatchWorker|AndroidFrameRenderer' } }",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
